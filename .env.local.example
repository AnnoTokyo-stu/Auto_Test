# 复制为 .env.local 后填写。该文件仅为模板，严禁填写真实账号后提交或分享。

# 长表单默认启用快速输入；如某个前端控件不兼容，可改为 false 回退 Selenium send_keys。
WEB_FAST_INPUT=true

# 生产环境专用测试注册数据。值含空格或特殊字符时保留双引号。
WEB_REGISTRATION_ACCOUNT=""
WEB_REGISTRATION_PASSWORD=""
WEB_REGISTRATION_NAME=""
WEB_REGISTRATION_PHONE=""
WEB_REGISTRATION_EMAIL=""

# 登录用例自动复用上述注册数据，无需重复填写。
TEST_USER_NAME=${WEB_REGISTRATION_ACCOUNT}
TEST_USER_PASSWORD=${WEB_REGISTRATION_PASSWORD}
TEST_USER_DISPLAY_NAME=${WEB_REGISTRATION_NAME}

# 其他测试角色按需配置。
TEST_ADMIN_NAME=""
TEST_ADMIN_PASSWORD=""
TEST_RBAC_USER_NAME=""
TEST_RBAC_USER_PASSWORD=""
TEST_DATA_PROVIDER_NAME=""
TEST_DATA_PROVIDER_PASSWORD=""
TEST_WRONG_PASSWORD=""
TEST_UNKNOWN_USER=""
