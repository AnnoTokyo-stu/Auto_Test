# 复制变量名到 PyCharm 运行配置或系统环境变量中；不要在项目中保存真实密码。
WEB_BASE_URL=http://border.embodatadeglobal.com:18080
WEB_ENTRY_PATH=/system/organization
WEB_BROWSER=chrome
WEB_HEADLESS=false
# true：快速填写主流程长表单；输入规则/逐键联动专项用例应设为 false。
WEB_FAST_INPUT=true
WEB_EXPLICIT_WAIT=10
WEB_PAGE_LOAD_TIMEOUT=30
WEB_MANUAL_CAPTCHA_TIMEOUT=120
WEB_MANUAL_EMAIL_CODE_TIMEOUT=300
WEB_PAGE_LOAD_STRATEGY=eager
# WEB_DRIVER_PATH=C:\path\to\chromedriver.exe

TEST_USER_NAME=
TEST_USER_PASSWORD=
TEST_USER_DISPLAY_NAME=
TEST_ADMIN_NAME=
TEST_ADMIN_PASSWORD=
TEST_RBAC_USER_NAME=
TEST_RBAC_USER_PASSWORD=
TEST_DATA_PROVIDER_NAME=
TEST_DATA_PROVIDER_PASSWORD=
TEST_DATA_CONSUMER_NAME=
TEST_DATA_CONSUMER_PASSWORD=
TEST_WRONG_PASSWORD=
TEST_UNKNOWN_USER=

# 由测试环境预先准备的业务数据编号；独立用例不依赖上一条用例的执行结果。
TEST_DECLARATION_ID=
TEST_ILLEGAL_DECLARATION_ID=
TEST_CONTRACT_ID=
TEST_ASSET_ID=
TEST_ORDER_ID=
TEST_PAYMENT_ID=
TEST_TRANSFER_ID=
TEST_COMPLETED_TRANSFER_ID=
TEST_EVIDENCE_ID=
TEST_ARCHIVE_BUSINESS_ID=

# 生产环境半自动注册数据：必须使用经批准的专用测试数据，不要使用个人信息。
WEB_REGISTRATION_ACCOUNT=
WEB_REGISTRATION_PASSWORD=
WEB_REGISTRATION_NAME=
WEB_REGISTRATION_PHONE=
WEB_REGISTRATION_EMAIL=
